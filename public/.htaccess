Options -MultiViews
RewriteEngine On

# 1. Si el archivo o carpeta existe físicamente, úsalo (ej: estilos css, imagenes)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# 2. Todo lo demás, mándalo a index.php pasando el slug en la variable 'p'
RewriteRule ^([^/]+)/?$ index.php?p=$1 [L,QSA]